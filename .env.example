# Copier ce fichier en .env.local et remplir avec les valeurs du projet Supabase
# (Tableau de bord Supabase → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# URL publique du site (liens de confirmation d'e-mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# NE JAMAIS mettre la clé secrète (service_role / sb_secret_) dans une variable NEXT_PUBLIC_
